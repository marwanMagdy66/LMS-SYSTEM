// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  INSTRUCTOR
  STUDENT
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id             String           @id @default(uuid()) @db.Uuid
  email          String           @unique
  name           String
  passwordHash   String
  phone          String?          @unique
  role           UserRole         @default(STUDENT)
  courses        Course[]         @relation("InstructorCourses")
  orders         Order[]
  enrollments    Enrollment[]
  lessonProgress LessonProgress[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model Course {
  id           String       @id @default(uuid()) @db.Uuid
  title        String
  description  String
  price        Decimal      @db.Decimal(10, 2)
  status       CourseStatus @default(DRAFT)
  instructor   User         @relation("InstructorCourses", fields: [instructorId], references: [id])
  instructorId String       @db.Uuid
  sections     Section[]
  orderItems   OrderItem[]
  enrollments  Enrollment[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Section {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  position  Int
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId  String   @db.Uuid
  lessons   Lesson[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //unique constraint to ensure that the combination of courseId and position is unique across all sections
  @@unique([courseId, position])
}

model Lesson {
  id            String  @id @default(uuid()) @db.Uuid
  title         String
  videoUrl      String?
  videoPublicId String?

  position  Int
  section   Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId String           @db.Uuid
  progress  LessonProgress[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([sectionId, position]) // unique constraint to ensure that the combination of sectionId and position is unique across all lessons
}

model Order {
  id          String      @id @default(uuid()) @db.Uuid
  student     User        @relation(fields: [studentId], references: [id])
  studentId   String      @db.Uuid
  status      OrderStatus @default(PENDING)
  totalAmount Decimal     @db.Decimal(10, 2)
  currency    String      @default("EGP")
  items       OrderItem[]
  payments    Payment[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model OrderItem {
  id        String   @id @default(uuid()) @db.Uuid
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String   @db.Uuid
  course    Course   @relation(fields: [courseId], references: [id])
  courseId  String   @db.Uuid
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  @@unique([orderId, courseId]) // unique constraint to ensure that the combination of orderId and courseId is unique across all order items
}

model Payment {
  id                   String        @id @default(uuid()) @db.Uuid
  order                Order         @relation(fields: [orderId], references: [id])
  orderId              String        @db.Uuid
  amount               Decimal       @db.Decimal(10, 2)
  status               PaymentStatus @default(PENDING)
  paymobIntentionId    String?       @unique
  paymobOrderId        String?       @unique
  transactionReference String?       @unique
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

model Enrollment {
  id        String   @id @default(uuid()) @db.Uuid
  student   User     @relation(fields: [studentId], references: [id])
  studentId String   @db.Uuid
  course    Course   @relation(fields: [courseId], references: [id])
  courseId  String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, courseId]) // unique constraint to ensure that the combination of studentId and courseId is unique across all enrollments
}

model LessonProgress {
  id          String   @id @default(uuid()) @db.Uuid
  student     User     @relation(fields: [studentId], references: [id])
  studentId   String   @db.Uuid
  lesson      Lesson   @relation(fields: [lessonId], references: [id])
  lessonId    String   @db.Uuid
  completedAt DateTime @default(now())

  @@unique([studentId, lessonId]) // unique constraint to ensure that the combination of studentId and lessonId is unique across all lesson progress records
}
